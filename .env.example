# Copy to .env (git-ignored) or export in your shell. No secrets belong in
# config files; LITECORD_* variables below are non-secret overrides.
LITECORD_DATA_DIR=.litecord
LITECORD_BACKEND=demo
LITECORD_LOG=info
# LITECORD_APPLICATION_ID=
# LITECORD_EVENT_QUEUE_CAPACITY=1024
# LITECORD_APPROVAL_TTL_SECS=600

# Native Social SDK location (only with --features discord-social-sdk):
# LITECORD_DISCORD_SDK_DIR=/path/to/vendor/discord-sdk

# Secrets: provided at runtime only, never logged or exposed to agents.
# LITECORD_BOT_TOKEN=
